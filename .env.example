# ────────────────────────────────────────────────────────────────────────────
# ThakAI Pipeline — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── AWS Core ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave blank if running on EC2/ECS with an IAM role (recommended for production).
# Provide explicit keys only for local development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Amazon S3 ─────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=thakai-documents
S3_LAWS_PREFIX=Laws/arabic/
S3_REGULATORY_PREFIX=Regulatory/arabic/

# ── Amazon RDS (PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=thakai
DB_USER=thakai_user
DB_PASSWORD=your_secure_password_here

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Claude 3.5 Sonnet v2 — recommended for document profiling & metadata extraction
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon Titan Embed Text v2 — for generating article embeddings
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

BEDROCK_MAX_TOKENS=4096

# ── Amazon Textract ───────────────────────────────────────────────────────────
# Minimum Textract confidence % to accept an OCR block (0–100)
TEXTRACT_CONFIDENCE_THRESHOLD=70.0

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
# Min Arabic chars on a page for PyMuPDF extraction to be considered successful.
# Pages below this threshold are sent to Textract for OCR.
MIN_ARABIC_CHARS_FOR_DIRECT_EXTRACT=100

# Number of pages to send to Bedrock for document profiling (Stage 2).
# 5 is usually sufficient for UAE legislation.
PROFILING_SAMPLE_PAGES=5

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
